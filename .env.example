# Copy to .env and fill in. .env is git-ignored.

# Port exposed by nginx on the host
APP_PORT=8080

# Version of the CI images used by "docker compose pull" (latest, a version like 1.2.3, or sha-<commit>)
IMAGE_TAG=latest

# PostgreSQL password (change it outside local development)
POSTGRES_PASSWORD=portfolio_dev

# Authentik OIDC application
AUTHENTIK_AUTHORITY=https://auth.example.com/application/o/portfolio/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
